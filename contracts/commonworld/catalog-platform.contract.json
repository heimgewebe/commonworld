{
  "kind": "commonworld.catalog_platform",
  "version": "1.1",
  "public_projection": {
    "manifest": "catalog/runtime/manifest.v1.json",
    "world_index": "catalog/runtime/world.v1.json",
    "mutable_truth_in_commonworld": false,
    "write_path": false,
    "shard_url_template": "catalog/runtime/shards/{sha256_prefix}.v1.json",
    "shard_strategy": {
      "algorithm": "sha256-prefix",
      "prefix_length": 2
    },
    "aggregate": "catalog/runtime/aggregate.v1.json",
    "aggregate_dimensions": [
      "theme",
      "spatial_cell_10_degree",
      "digital_availability"
    ],
    "details": {
      "strategy": "content-addressed-shard-descriptors",
      "descriptor_version": "1.0",
      "url_template": "catalog/runtime/details/{sha256}.v1.json",
      "descriptor_fields": [
        "version",
        "identity",
        "generation",
        "url",
        "sha256",
        "bytes"
      ],
      "mutable_identity_path_for_runtime_loading": false
    }
  },
  "generation": {
    "algorithm": "sha256",
    "seed_binds": [
      "source_catalog_sha256",
      "detail_set_sha256",
      "project_schema_version",
      "detail_descriptor_version"
    ],
    "manifest_integrity_descriptors": [
      "world_index_sha256",
      "aggregate_sha256",
      "shards_sha256",
      "detail_payload_sha256"
    ],
    "atomic_activation_required": true
  },
  "world_index_record": {
    "required": [
      "id",
      "title",
      "themes",
      "actions",
      "languages",
      "access",
      "presence",
      "activity",
      "detail"
    ],
    "forbidden": [
      "summary",
      "provenance",
      "links",
      "curation",
      "handoff"
    ]
  },
  "detail_validation_boundary": {
    "build_and_ci": "complete_project_schema_v4_validation_and_canonical_serialization",
    "browser": [
      "same_origin",
      "document_root_containment",
      "manifest_generation",
      "descriptor_identity",
      "content_addressed_url",
      "byte_length",
      "sha256",
      "utf8_json",
      "schema_version_4",
      "bounded_top_level_shape",
      "selected_identity",
      "compact_projection_parity"
    ],
    "browser_reimplements_complete_json_schema": false,
    "visible_data_replacement": false
  },
  "runtime_cache": {
    "shards_max_entries": 8,
    "details_max_entries": 16,
    "eviction": "least_recently_used_deterministic",
    "failed_promises_retained": false,
    "generation_change_clears_caches": true,
    "explicit_retry_refresh": "reload_manifest_aggregate_and_clear_shard_detail_caches"
  },
  "weltgewebe_alignment": {
    "canonical_store": "postgresql",
    "spatial_extension": "postgis_when_proven",
    "read_api": "rust_axum",
    "projection_transport": [
      "immutable_static_snapshot",
      "read_only_api"
    ],
    "eventing_target": "transactional_outbox_plus_nats_jetstream",
    "map_transport": "pmtiles_when_measured"
  },
  "excluded_without_measured_need": [
    "elasticsearch",
    "opensearch",
    "typesense",
    "meilisearch",
    "standalone_semantic_service",
    "ann_hnsw"
  ],
  "browser_transition": {
    "current_visible_catalog": "build_bound_bootstrap",
    "shadow_runtime_observation": {
      "aggregate_manifest": true,
      "selected_identity_shard": true,
      "selected_identity_detail": true
    },
    "selection_states": [
      "idle",
      "loading",
      "retrying",
      "ready",
      "mismatch",
      "degraded"
    ],
    "aggregate_failure_policy": "keep_compatible_bootstrap_and_mark_degraded",
    "shard_failure_policy": "keep_compatible_bootstrap_and_mark_selected_identity_degraded",
    "detail_failure_policy": "keep_compatible_bootstrap_and_offer_selected_identity_fresh_platform_retry",
    "stale_response_policy": "selection_generation_must_match_before_state_commit",
    "selected_identity_parity_fields": [
      "id",
      "title",
      "themes",
      "actions",
      "languages",
      "access",
      "activity",
      "digital_presence",
      "public_geographic_presence"
    ],
    "selected_detail_parity": "exact_canonical_record_after_integrity_and_runtime_boundary_checks",
    "cutover_authorized": false,
    "cutover_gate": [
      "compact_and_detail_parity",
      "german_english_parity",
      "deep_link_and_history_parity",
      "no_javascript_parity",
      "offline_and_fault_fallback",
      "supported_browser_matrix",
      "four_times_cpu_budget",
      "rollback_artifact",
      "production_generation_readback",
      "separate_physical_device_readback"
    ]
  }
}
