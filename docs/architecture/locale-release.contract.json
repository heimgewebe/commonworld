      },
      "translation_pack": "wave_1",
      "release_evidence": {
        "path": "docs/evidence/locale-releases/ar.json",
        "sha256": "c70abff26711d9ce77627898a68fd3ba8063f3600429053b5e7138ebf6ee2379"
