{
  "schema_version": 1,
  "kind": "commonworld.ui_locale_release_contract",
  "title": "Commonworld staged interface-language release contract",
  "decision": {
    "released_locales": [
      "en",
      "de",
      "es",
      "fr",
      "pt-BR",
      "ar",
      "zh-Hans",
      "hi"
    ],
    "default_locale": "en",
    "fallback_locale": "de",
    "automatic_selection": {
      "precedence": [
        "explicit_url",
        "stored_preference",
        "browser_language_order",
        "default_locale"
      ],
      "geolocation_must_not_influence_locale": true,
      "explicit_surface_must_resist_stored_override": true,
      "preserve_query_and_fragment": true
    },
    "baseline_locales": [
      "en",
      "de"
    ]
  },
  "tag_policy": {
    "standard": "BCP 47",
    "canonical_ui_tag_pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$",
    "matching_order": [
      "exact",
      "language_script",
      "scriptless_primary",
      "next_preference_on_script_mismatch",
      "primary_language_without_script",
      "default_locale"
    ],
    "case_insensitive_input": true,
    "canonical_output_required": true,
    "script_and_region_must_be_preserved": true,
    "requested_script_mismatch_must_not_cross_scripts": true,
    "region_inferred_script_counts_as_script_for_matching": true,
    "region_script_inference": {
      "zh": {
        "Hans": [
          "CN",
          "SG"
        ],
        "Hant": [
          "TW",
          "HK",
          "MO"
        ]
      }
    }
  },
  "content_language_policy": {
    "independent_from_interface_locales": true,
    "valid_bcp47_tags_allowed": true,
    "must_not_be_rewritten_to_interface_locale": true,
    "unknown_language_must_remain_explicit": true
  },
  "locale_registry": {
    "en": {
      "status": "released",
      "direction": "ltr",
      "surface_files": {
        "index": "index.html",
        "method": "method.html",
        "proposal": "propose.html"
      },
      "native_name": "English",
      "english_name": "English"
    },
    "de": {
      "status": "released",
      "direction": "ltr",
      "surface_files": {
