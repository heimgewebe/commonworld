{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonworld.net/contracts/commonworld/regional-context.schema.json",
  "title": "Non-geometric, source-bound public regional context for CommonProjects",
  "description": "A versioned editorial context index separate from canonical project geography. Optional source-bound navigation views are camera extents only, never project geometry, locations, territory, member coordinates, coverage or inferred country membership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "contexts"
  ],
  "properties": {
    "kind": {
      "const": "commonworld.public-regional-contexts"
    },
    "schema_version": {
      "const": 1
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/context"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,95}$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "de",
        "en"
      ],
      "properties": {
        "de": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "en": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "reference",
        "relation",
        "minimum_semantic_level",
        "coverage_claim",
        "source_ids",
        "source_reviewed_at",
        "public_notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "labels"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "named_region",
                "bioregion",
                "distributed_network"
              ]
            },
            "labels": {
              "$ref": "#/$defs/labels"
            }
          }
        },
        "relation": {
          "enum": [
            "currency-use-region",
            "stewardship-bioregion",
            "distributed-member-network"
          ]
        },
        "minimum_semantic_level": {
          "enum": [
            "planet",
            "macroregion",
            "region"
          ]
        },
        "coverage_claim": {
          "const": "none"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "public_notes": {
          "$ref": "#/$defs/labels"
        },
        "navigation_views": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/navigationView"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "named_region"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "relation": {
                "const": "currency-use-region"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "bioregion"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "relation": {
                "const": "stewardship-bioregion"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "distributed_network"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "relation": {
                "const": "distributed-member-network"
              }
            }
          }
        }
      ]
    },
    "navigationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labels",
        "view_bounds",
        "source_label",
        "source_url",
        "license",
        "association_source_ids",
        "purpose",
        "reviewed_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "view_bounds": {
          "description": "West, south, east, north; a public reference-map viewport only, not project geometry. No dateline wrap in this pilot.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -85,
              "maximum": 85
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -85,
              "maximum": 85
            }
          ],
          "items": false
        },
        "source_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "association_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "purpose": {
          "const": "camera_only"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
