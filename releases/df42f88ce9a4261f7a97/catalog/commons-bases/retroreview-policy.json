{
  "schema_version": 1,
  "kind": "commonworld_commons_basis_retroreview_policy",
  "current_as_of": "2026-07-31",
  "scope": {
    "selection": "all_catalog_records_without_commons_basis",
    "dynamic": true
  },
  "deadline": {
    "source_field": "curation.next_review_at",
    "missing_deadline_is_error": true,
    "migration_grace_until": "2026-08-31",
    "effective_deadline": "later_of_next_review_at_and_migration_grace_until"
  },
  "publication_effect": {
    "before_deadline": "legacy_record_may_remain_in_current_curation_state_but_is_not_retroactively_certified",
    "after_deadline": "record_must_have_a_basis_or_be_stale_or_archived",
    "automatic_publication_or_rejection": false
  },
  "priority_rules": [
    "commercial_or_platform_boundary",
    "centralized_control_tension",
    "weak_or_indirect_governance_evidence",
    "next_review_at_ascending"
  ]
}
